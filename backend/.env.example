# Port the API listens on
PORT=4000
# Public URL of this server (used for auth callbacks). From an Android emulator use http://10.0.2.2:4000
BETTER_AUTH_URL=http://localhost:4000
# Long random string used to sign sessions: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me
# Postgres connection string. Leave empty to use an embedded Postgres (PGlite) stored in ./data/pglite
DATABASE_URL=
# Comma-separated extra origins allowed to call the API (the Expo web dev server)
CORS_ORIGINS=http://localhost:8081
# The mobile app's URL scheme (app.json "scheme"), trusted for sign-in redirects
APP_SCHEME=flashcards
# Google sign-in (optional). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with redirect URI {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
