# Port the API listens on
PORT=4000
# Public URL of this server (used for auth callbacks). From an Android emulator use http://10.0.2.2:4000
# AI apps connect to {BETTER_AUTH_URL}/mcp, so for ChatGPT/Claude this must be a public https URL
# (a deployed server, or a tunnel while developing: see README.md "Connect an AI app").
BETTER_AUTH_URL=http://localhost:4000
# Long random string used to sign sessions: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me
# Postgres connection string. Leave empty to use an embedded Postgres (PGlite) stored in ./data/pglite
DATABASE_URL=
# Comma-separated extra origins allowed to call the API (the Expo web dev server)
CORS_ORIGINS=http://localhost:8081
# The mobile app's URL scheme (app.json "scheme"), trusted for sign-in redirects
APP_SCHEME=flashcards
# Sign in with Google / Microsoft / Facebook (each optional: a button shows in the app once both values are set).
# Every provider needs the redirect URI {BETTER_AUTH_URL}/api/auth/callback/<provider>, e.g.
# http://localhost:4000/api/auth/callback/google. See README.md "Sign-in providers".
# Google: https://console.cloud.google.com/apis/credentials → OAuth client ID → Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft (school, work and personal accounts): https://entra.microsoft.com → App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common = any Microsoft account; or a school's tenant id to allow only that school
MICROSOFT_TENANT_ID=common
# Facebook: https://developers.facebook.com/apps → Facebook Login
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
